---
import '~/styles/global.css';
import { u } from '~/lib/url';

type Props = {
  title: string;
  description?: string;
  hideHeader?: boolean;
};
const { title, description, hideHeader } = Astro.props;
const canonicalPath = Astro.url.pathname;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#0a0a0a" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" href={u('/favicon.svg')} type="image/svg+xml" />
  </head>
  <body>
    {!hideHeader && (
      <header class="site-header">
        <div class="container">
          <a class="site-title" href={u('/')}>Modifier Project</a>
          <nav class="site-nav" aria-label="Primary">
            <a href={u('/compare')}
               aria-current={canonicalPath.includes('/compare') ? 'page' : null}>Compare</a>
            <a href={u('/method')}
               aria-current={canonicalPath.includes('/method') ? 'page' : null}>Method</a>
          </nav>
        </div>
      </header>
    )}
    <main class="container">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="container">
        <span>Everything held constant. Only the modifier changes.</span>
        <a href="https://www.instagram.com/joshsmoore137/" rel="me noopener" target="_blank">@joshsmoore137</a>
      </div>
    </footer>
  </body>
</html>
