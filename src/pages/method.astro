---
import Base from '~/layouts/Base.astro';
import { getCollection } from 'astro:content';
import { getClassGroups } from '~/lib/classes';
import { getPublishedModifierIds } from '~/lib/published';
import { u } from '~/lib/url';

const [groups, published] = await Promise.all([getClassGroups(), getPublishedModifierIds()]);
const shots = (await getCollection('shots')).filter((s) =>
  published.has(s.data.modifier.id),
);

const modifierLabel = new Map<string, { label: string; groupSlug: string }>();
for (const g of groups) {
  for (const m of g.modifiers) modifierLabel.set(m.id, { label: m.data.name, groupSlug: g.slug });
}

const rows = shots
  .map((s) => {
    const meta = modifierLabel.get(s.data.modifier.id);
    return {
      id: s.id,
      modifier: meta?.label ?? s.data.modifier.id,
      modifierSlug: s.data.modifier.id,
      groupSlug: meta?.groupSlug ?? '',
      subject: s.data.subject,
      iso: s.data.iso,
      power: s.data.power,
      distance: s.data.distance,
      notes: s.data.notes ?? '',
    };
  })
  .sort((a, b) => a.modifier.localeCompare(b.modifier) || a.subject.localeCompare(b.subject));
---

<Base title="Method — Modifier Project" description="How these shots were made.">
  <header style="margin-bottom: var(--s-5);">
    <h1 style="margin: 0;">Method</h1>
  </header>

  <section class="prose">
    <h2>Setup</h2>
    <p>
      Camera, light position, and both subjects are fixed to marks on the table.
      For every frame, the modifier's front face is placed at the same distance
      from the subject (measured, not eyeballed). The shutter speed, aperture,
      and ISO are also fixed; flash power is adjusted so the lit area on the
      subject exposes the same. Ambient is killed — the no-flash frame proves it.
      The only processing is whitebalancing done with a netreul grea card.
      I am eyeballing the power and doing nothing post processing to balance it so there
      is some variation but I keep it as close as possible.
    </p>

    <h2>Gear</h2>
    <ul>
      <li>Camera: Nikon Z7-II</li>
      <li>Lens: Tamron 35-150mm f/2-2.8 Di III VXD (locked to 35mm)</li>
      <li>Flash: Godox AD 200 Pro</li>
      <li>Trigger: GoDox XPro II</li>
      <li>Light stand: standard</li>
      <li>Backdrop: black, non-reflective</li>
      <li>Modifiers: everything on this site</li>
    </ul>

    <h2>Measurements</h2>
    <p>
      "Distance" is the distance from the modifier's <em>front face</em> to the
      dot on the table I center the subject on, not the flash head itself. "Power" is the fractional
      output on the speedlight;
    </p>
  </section>

  <h2 style="margin-top: var(--s-6);">Log</h2>
  <p class="small">Click a column header to sort.</p>
  <div style="overflow-x: auto;">
    <table class="log" id="log">
      <thead>
        <tr>
          <th data-key="modifier" aria-sort="ascending">Modifier</th>
          <th data-key="subject">Subject</th>
          <th data-key="iso">ISO</th>
          <th data-key="power">Power</th>
          <th data-key="distance">Distance</th>
          <th data-key="notes">Notes</th>
        </tr>
      </thead>
      <tbody>
        {rows.map((r) => (
          <tr>
            <td><a href={u(`/${r.groupSlug}/${r.modifierSlug}`)} style="border: 0; color: var(--fg);">{r.modifier}</a></td>
            <td>{r.subject}</td>
            <td>{r.iso}</td>
            <td>{r.power}</td>
            <td>{r.distance}"</td>
            <td>{r.notes}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>

  <script>
    const table = document.getElementById('log') as HTMLTableElement | null;
    if (table) {
      const tbody = table.tBodies[0]!;
      const headers = table.querySelectorAll<HTMLTableCellElement>('th[data-key]');
      let currentKey = 'modifier';
      let ascending = true;

      const getValue = (row: HTMLTableRowElement, idx: number) =>
        row.cells[idx]?.textContent?.trim() ?? '';

      const sortBy = (key: string, idx: number) => {
        if (currentKey === key) ascending = !ascending;
        else { currentKey = key; ascending = true; }

        headers.forEach((h) => h.removeAttribute('aria-sort'));
        headers[idx]!.setAttribute('aria-sort', ascending ? 'ascending' : 'descending');

        const rows = Array.from(tbody.rows);
        rows.sort((a, b) => {
          const av = getValue(a, idx);
          const bv = getValue(b, idx);
          const an = parseFloat(av);
          const bn = parseFloat(bv);
          const cmp = (!isNaN(an) && !isNaN(bn)) ? an - bn : av.localeCompare(bv);
          return ascending ? cmp : -cmp;
        });
        for (const r of rows) tbody.appendChild(r);
      };

      headers.forEach((h, i) => h.addEventListener('click', () => sortBy(h.dataset.key!, i)));
    }
  </script>
</Base>
